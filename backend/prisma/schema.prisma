generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  FACILITY_MANAGER
  FACILITY_USER
  TECHNICIAN
  SERVICE_PROVIDER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CRITICAL
}

enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  HVAC
  STRUCTURAL
  SECURITY
  CLEANING
  EQUIPMENT
  OTHER
}

enum MaintenanceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PreventiveMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  phone     String?
  role      UserRole   @default(FACILITY_USER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  maintenanceRequests MaintenanceRequest[]
  assignedWorkOrders  WorkOrder[]          @relation("TechnicianWorkOrders")
  notifications       Notification[]
  serviceProviderJobs WorkOrder[]          @relation("ServiceProviderWorkOrders")
}

model Facility {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]
}

model Asset {
  id               Int            @id @default(autoincrement())
  facilityId       Int
  name             String
  category         String
  serialNumber     String?        @unique
  description      String?
  installationDate DateTime?
  condition        AssetCondition @default(GOOD)
  criticality      Int            @default(1)
  riskLevel        RiskLevel      @default(LOW)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  facility              Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  maintenanceRequests   MaintenanceRequest[]
  maintenanceHistory    MaintenanceHistory[]
  preventiveMaintenance PreventiveMaintenance[]
}

model MaintenanceRequest {
  id                Int                 @id @default(autoincrement())
  requestNumber     String              @unique
  userId            Int
  assetId           Int?
  category          MaintenanceCategory
  description       String
  imageUrl          String?
  severity          MaintenanceSeverity
  priority          MaintenancePriority @default(MEDIUM)
  status            MaintenanceStatus   @default(PENDING)
  operationalImpact Int                 @default(1)
  urgency           Int                 @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  asset     Asset?     @relation(fields: [assetId], references: [id])
  workOrder WorkOrder?
}

model WorkOrder {
  id                Int             @id @default(autoincrement())
  workOrderNumber   String          @unique
  requestId         Int             @unique
  technicianId      Int?
  serviceProviderId Int?
  assignedDate      DateTime?
  dueDate           DateTime?
  completedDate     DateTime?
  status            WorkOrderStatus @default(ASSIGNED)
  notes             String?
  labourCost        Decimal?        @db.Decimal(12, 2)
  materialCost      Decimal?        @db.Decimal(12, 2)
  otherCost         Decimal?        @db.Decimal(12, 2)
  totalCost         Decimal?        @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  request         MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  technician      User?              @relation("TechnicianWorkOrders", fields: [technicianId], references: [id])
  serviceProvider User?              @relation("ServiceProviderWorkOrders", fields: [serviceProviderId], references: [id])

  maintenanceHistory MaintenanceHistory?
}

model MaintenanceHistory {
  id              Int      @id @default(autoincrement())
  assetId         Int
  workOrderId     Int      @unique
  description     String
  maintenanceDate DateTime @default(now())
  cost            Decimal? @db.Decimal(12, 2)
  remarks         String?
  createdAt       DateTime @default(now())

  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model PreventiveMaintenance {
  id            Int                         @id @default(autoincrement())
  assetId       Int
  scheduledDate DateTime
  frequency     String
  description   String
  status        PreventiveMaintenanceStatus @default(SCHEDULED)
  completedDate DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
